# Development environment: cp .env.dev.example .env && docker compose up -d --build
# Public example values: never use them on a server (see .env.prod.example).
COMPOSE_PROFILES=mailpit

# *.localhost resolves to this machine in browsers; inside the containers
# NOP_HOST is mapped to the Docker host (nopCommerce calls its own URL).
NOP_URL=http://shop.localhost:8115
NOP_HOST=shop.localhost
SITE_ADDRESS=:80
HTTP_PORT=8115
HTTPS_PORT=8415
MAILPIT_PORT=8025

DB_PASSWORD=nopcommerce
NOP_ADMIN_EMAIL=admin@example.com
NOP_ADMIN_PASSWORD=admin12345
NOP_STORE_NAME=Tienda

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
SMTP_FROM_NAME=Tienda
