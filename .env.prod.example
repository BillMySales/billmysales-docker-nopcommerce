# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d --build
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=nopcommerce

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the store (the admin is <url>/admin). Applied on
# every `up`.
NOP_URL=https://shop.example.com
# REQUIRED. The host name of NOP_URL: nopCommerce runs its scheduled tasks
# (emails, ...) by calling its own URL, so this host is resolved to the
# Docker host (where Caddy or Traefik publishes the site) inside the
# container.
NOP_HOST=shop.example.com
# Other host names Caddy passes on to nopCommerce (space separated), e.g.
# www.example.com; any other Host header gets HTTP 400.
#NOP_EXTRA_HOSTS=
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# Time zone of the containers (every start) and the store's time zone
# setting (first install only; later in the admin).
#TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 32)
# ---------------------------------------------------------------------------
DB_PASSWORD=
# First admin user (created by the installer; only used then: changing them
# later in .env doesn't change the account).
NOP_ADMIN_EMAIL=
NOP_ADMIN_PASSWORD=
#DB_USER=nopcommerce
#DB_NAME=nopcommerce

# ---------------------------------------------------------------------------
# Store (initial settings, applied only on the first install; later changes
# in the admin are kept)
# ---------------------------------------------------------------------------
# Store name (also the default sender name of emails, on every `up`).
#NOP_STORE_NAME=nopCommerce
# Country and culture given to the installer, as country-culture (one of the
# installer's list: CL-es-CL, US-en-US, ES-es-ES, DE-de-DE...; any other
# value stops setup before installing). The store gets that culture's
# language (its pack is downloaded from nopcommerce.com; English if it
# can't be) and the country's currency as the only published ones. With a
# Spanish culture, the tax categories, shipping and payment method get
# Spanish names; for Chile, postal codes are optional.
#NOP_COUNTRY_CULTURE=CL-es-CL
# Tax rate (%) of the first tax category ("Afecto", or "Taxable" in English);
# empty = 0.
#NOP_TAX_RATE=19
# Prices include tax (as usual in Chile).
#NOP_PRICES_INCLUDE_TAX=true
# Spanish email templates (config/nopcommerce/message-templates.es.json),
# with a Spanish culture only.
#NOP_EMAILS_SPANISH=true

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# nopCommerce release (the official image the application is taken from)
# and .NET runtime of the image (image/Dockerfile). After changing them,
# `docker compose up -d --build` rebuilds the image and setup runs
# nopCommerce's database migrations. Back up first.
#NOP_VERSION=4.90.8
#DOTNET_VERSION=9.0
#NOP_IMAGE=nopcommerce-stack
#POSTGRES_VERSION=18
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit web UI port (development only, profile "mailpit").
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Mail (SMTP, recommended, not required): order and shipment emails,
# account emails, store owner notifications (the store's email account,
# rewritten on every `up`). Without SMTP_HOST no emails are sent (they stay
# queued).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls or empty (STARTTLS when the server offers it, usually port 587),
# ssl (SMTPS, port 465) or none.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address and name (default: noreply@example.com and NOP_STORE_NAME);
# also the address of store owner notifications.
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#SETUP_MEMORY_LIMIT=1g
#NOP_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
