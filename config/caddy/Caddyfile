# Caddy in front of nopCommerce (Kestrel): TLS and security headers.
{
	# No admin API: config is static, reloads happen by restarting the container.
	admin off

	servers {
		# Behind a reverse proxy on a private network, log the real client IP
		# (X-Forwarded-For) and pass X-Forwarded-Proto on to nopCommerce.
		trusted_proxies static private_ranges
		# Client IP = the right-most untrusted address (can't be spoofed).
		trusted_proxies_strict
	}
}

(nop) {
	encode zstd gzip

	request_body {
		max_size {$UPLOAD_MAX_SIZE}
	}

	# One directive per header: in a single `header { }` block, Caddy applies
	# the "?" (set if missing) fields together, only when all are missing.
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options SAMEORIGIN
	header ?Referrer-Policy strict-origin-when-cross-origin
	header -Server

	# Only the store's host (NOP_HOST, NOP_EXTRA_HOSTS) and loopback names
	# (the healthcheck): nopCommerce builds URLs from the request's Host and
	# caches pages, so one request with a forged Host served its image URLs
	# to every visitor.
	@foreign not host {$NOP_HOST} {$NOP_EXTRA_HOSTS} localhost 127.0.0.1
	handle @foreign {
		respond 400
	}

	# The installer only answers before the installation; never publish it.
	@install path /install /install/*
	handle @install {
		respond 404
	}

	handle {
		# ASP.NET's forwarded headers take the last X-Forwarded-For entry;
		# send only the real client IP.
		reverse_proxy nop:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Public site. SITE_ADDRESS is ":80" for plain HTTP (local, or behind another
# proxy) or a domain name, which makes Caddy obtain and renew a certificate
# automatically ("localhost" uses Caddy's internal CA).
{$SITE_ADDRESS} {
	import nop
	log {
		output stdout
	}
}

# Internal-only site (port not published) for the container healthcheck.
:8080 {
	import nop
}
